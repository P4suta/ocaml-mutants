# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Type-aware mutation testing for Dune projects"
description:
  "ocaml-mutants is a pre-release, type-aware mutation testing CLI for Dune projects. It targets Windows, Linux, and macOS; cross-platform acceptance and the remaining directory-capability migration are release gates. It discovers high-signal candidates from compiler Typedtrees, instruments an isolated workspace snapshot once, and switches mutants with an environment variable while leaving the source workspace untouched."
maintainer: ["Yasunobu <ocaml.bagged925@slmails.com>"]
authors: ["Yasunobu <ocaml.bagged925@slmails.com>"]
license: "MIT OR Apache-2.0"
homepage: "https://github.com/P4suta/ocaml-mutants"
bug-reports: "https://github.com/P4suta/ocaml-mutants/issues"
depends: [
  "ocaml" {>= "5.4" & < "5.6"}
  "dune" {>= "3.21" & < "4.0"}
  "cmdliner" {>= "2.0"}
  "csexp" {>= "1.5"}
  "digestif" {>= "1.2"}
  "fmt" {>= "0.11"}
  "fpath" {>= "0.7"}
  "logs" {>= "0.8"}
  "mtime" {>= "2.1"}
  "otoml" {>= "1.0"}
  "ptime" {>= "1.2"}
  "yojson" {>= "2.2"}
  "alcotest" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/P4suta/ocaml-mutants.git"
x-maintenance-intent: ["(latest)"]
