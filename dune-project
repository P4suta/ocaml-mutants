(lang dune 3.22)
(name ocaml-mutants)
(version 1.0.0)
(generate_opam_files true)
(source (github P4suta/ocaml-mutants))
(license "MIT OR Apache-2.0")
(authors "Yasunobu <ocaml.bagged925@slmails.com>")
(maintainers "Yasunobu <ocaml.bagged925@slmails.com>")
(maintenance_intent "(latest)")

(package
 (name ocaml-mutants)
 (synopsis "Type-aware mutation testing for Dune projects")
 (description
  "ocaml-mutants 1.0 is a local-first, type-aware mutation testing CLI for Dune projects on Windows, Linux, and macOS. It separates authoritative measurement from policy, provides deterministic CI sharding, crash recovery, offline reports, and a full-screen TUI, while leaving the source workspace untouched during ordinary operation.")
 (depends
  (ocaml (and (>= 5.4) (< 5.6)))
  (dune (and (>= 3.22) (< 4.0)))
  (cmdliner (>= 2.0))
  (csexp (>= 1.5))
  (digestif (>= 1.2))
  (fmt (>= 0.11))
  (fpath (>= 0.7))
  (logs (>= 0.8))
  (mtime (>= 2.1))
  (otoml (>= 1.0))
  (ptime (>= 1.2))
  (yojson (>= 2.2))
  (matrix (= 0.1.0))
  (mosaic (= 0.1.0))
  (alcotest :with-test)
  (qcheck-alcotest :with-test)
  (odoc :with-doc)))
