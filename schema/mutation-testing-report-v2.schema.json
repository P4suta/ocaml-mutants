{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/P4suta/ocaml-mutants/schema/mutation-testing-report-v2.schema.json",
  "title": "ocaml-mutants Mutation Testing Report Schema v2 projection",
  "description": "The strict Mutation Testing Report Schema v2 surface emitted by ocaml-mutants. Complete modeled OCaml-specific engine state remains in run-report-v1; process-output captures there are intentionally bounded.",
  "type": "object",
  "required": ["schemaVersion", "thresholds", "files"],
  "properties": {
    "schemaVersion": { "const": "2" },
    "thresholds": { "$ref": "#/definitions/thresholds" },
    "files": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/definitions/file" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "thresholds": {
      "type": "object",
      "required": ["high", "low"],
      "properties": {
        "high": { "type": "integer", "minimum": 0, "maximum": 100 },
        "low": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["language", "source", "mutants"],
      "properties": {
        "language": { "const": "ocaml" },
        "source": { "type": "string" },
        "mutants": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/mutant" }
        }
      },
      "additionalProperties": false
    },
    "mutant": {
      "type": "object",
      "required": ["id", "mutatorName", "replacement", "location", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mutatorName": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "location": { "$ref": "#/definitions/location" },
        "status": {
          "enum": ["Killed", "Survived", "NoCoverage", "CompileError", "RuntimeError", "Timeout", "Ignored", "Pending"]
        },
        "statusReason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/position" },
        "end": { "$ref": "#/definitions/position" }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
