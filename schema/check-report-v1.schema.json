{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/P4suta/ocaml-mutants/schema/check-report-v1.schema.json",
  "title": "ocaml-mutants check-report-v1",
  "type": "object",
  "required": ["document_type", "schema_version", "run_id", "verdict", "exit_code", "policy", "evidence", "summary", "findings"],
  "properties": {
    "document_type": { "const": "ocaml-mutants.check-report-v1" },
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["passed", "policy-violation", "refused"] },
    "exit_code": { "enum": [0, 1, 2] },
    "policy": {
      "type": "object",
      "required": ["require_complete", "max_unexpected_survivors", "minimum_score", "maximum_score_drop", "allow_estimated"],
      "properties": {
        "require_complete": { "type": "boolean" },
        "max_unexpected_survivors": { "type": "integer", "minimum": 0 },
        "minimum_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "maximum_score_drop": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "allow_estimated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["level", "complete", "reference_score"],
      "properties": {
        "level": { "enum": ["executed", "exact-cache", "estimated"] },
        "complete": { "type": "boolean" },
        "reference_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["total", "executed", "unexpected_survivors", "inconclusive", "error", "score"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "unexpected_survivors": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "kind", "message", "actual", "required"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "kind": { "enum": ["policy-violation", "evidence-refusal"] },
          "message": { "type": "string" },
          "actual": { "type": ["string", "null"] },
          "required": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
